# ─── BACKEND ──────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Use a SEPARATE database for dev vs production (e.g. /clinicflow-dev vs /clinicflow)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clinicflow-dev?retryWrites=true&w=majority

# JWT secret — use a long random string, different for dev and prod
JWT_SECRET=your_local_dev_jwt_secret_change_this

# Express server port
PORT=5000

# Set to "development" locally — Vercel sets this automatically in production
NODE_ENV=development

# Allowed CORS origin — your local React dev server
CLIENT_URL=http://localhost:5173

# Google OAuth Client ID (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── FRONTEND (Vite) ──────────────────────────────────────────────────────────
# These go in client/.env (create that file separately)

# Leave empty locally — vite.config.js proxy handles /api/* → localhost:5000
# VITE_API_URL=

# Socket.IO URL for local dev
# VITE_SOCKET_URL=http://localhost:5000

# Google OAuth Client ID (same value as GOOGLE_CLIENT_ID above — safe to expose)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
