# MongoDB
MONGO_URI=mongodb+srv://<your_username>:<your_password>@cluster0.mongodb.net/clinicflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Server
PORT=5000
NODE_ENV=development

# Client
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# WordPress Blog (Doctor Dashboard)
# Note: WordPress credentials are stored per-doctor in MongoDB
# Each doctor configures their own WordPress site URL and Application Password
# through the "My Blog" section of the doctor dashboard.
# No shared WordPress config needed in environment variables.
