{
  "name": "MediQ",
  "version": "1.0.0",
  "description": "MediQ - Clinic Management & Smart Patient Queue System",
  "keywords": [],
  "homepage": "https://github.com/NimishBm/Medi#readme",
  "bugs": {
    "url": "https://github.com/NimishBm/Medi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NimishBm/Medi.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "vercel-build": "npm install && npm --prefix client install && npm --prefix client run build",
    "start": "node server.js",
    "server:dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed-orgs": "node scripts/seedOrganizations.js",
    "seed-bodhi": "node scripts/importBodhi.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:preview": "cd client && npm run preview"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "multer": "^2.4.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
